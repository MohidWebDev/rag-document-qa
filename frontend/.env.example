# The frontend never talks to Gemini directly; the API key lives in backend/.env.

# Where the FastAPI backend runs. The Vite dev server proxies /api/* to it.
BACKEND_URL="http://127.0.0.1:8000"

# Optional: call the backend at this URL instead of the /api proxy
# (e.g. a production build served from a different origin). Add that
# origin to CORS_ORIGINS in backend/.env as well.
# VITE_API_URL="https://api.example.com"
